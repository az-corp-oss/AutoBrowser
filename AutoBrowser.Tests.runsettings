<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Timeout for each individual test case (in milliseconds) -->
    <TestCaseTimeout>20000</TestCaseTimeout>
    <!-- Timeout for the entire test session (in milliseconds) -->
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>