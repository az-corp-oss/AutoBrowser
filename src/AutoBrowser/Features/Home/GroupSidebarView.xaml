<UserControl x:Class="AutoBrowser.Views.GroupSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:AutoBrowser.Models"
             xmlns:converters="clr-namespace:AutoBrowser.Converters"
             AutomationProperties.AutomationId="GroupSidebar">
    <UserControl.Resources>
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8,10">
        <DockPanel>
            <ui:TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Groups"/>

            <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding ActiveGroup, Mode=TwoWay}"
                     KeyDown="GroupList_KeyDown"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:RuleGroup}">
                        <Border x:Name="GroupCard" CornerRadius="6" Padding="10,8"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:ToggleSwitch Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                 OffContent="" OnContent="" Width="40"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <Grid Grid.Column="1">
                                    <ui:TextBlock x:Name="GroupNameText" FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                  VerticalAlignment="Center"
                                                  MouseLeftButtonDown="GroupNameText_MouseLeftButtonDown"/>

                                    <TextBox x:Name="GroupNameEdit" Visibility="Collapsed"
                                             Text="{Binding Name, UpdateSourceTrigger=Explicit}" FontSize="14" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                                             BorderBrush="{DynamicResource SystemAccentColorBrush}"
                                             Padding="4,2" VerticalAlignment="Center"
                                             KeyDown="GroupNameEdit_KeyDown"
                                             LostFocus="GroupNameEdit_LostFocus"/>
                                </Grid>

                                <ui:TextBlock Grid.Column="2" Margin="8,0,0,0" FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding Sequence, StringFormat='#{0}'}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.ActiveGroup" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="GroupCard" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
